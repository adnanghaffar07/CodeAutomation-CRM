# CodeAutomation CRM: every env var any module reads. Copy to .env.local for dev.
# Values come from your Supabase project (Connect panel and Project Settings → API Keys).

# Postgres on the Supabase cloud project.
# The app connects as crm_app (a non-superuser) so row-level security is enforced.
# DATABASE_URL = pooled (port 6543, add ?pgbouncer=true); DIRECT_URL = used by Prisma db push.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth (identity only; roles and workspaces live in our own tables).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only secret key. Never expose to the browser. Used for admin actions (invite, suspend).
SUPABASE_SERVICE_ROLE_KEY=""

# Public base URL (links in emails, OAuth redirect base).
APP_URL="http://localhost:3000"

# Encrypts stored integration credentials (Phase 1+). Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""
