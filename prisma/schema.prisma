// CodeAutomation CRM schema. Phase 0 holds only the multi-tenancy root so the
// database connection can be verified end to end. Phase 1 adds roles,
// permissions and audit; Phase 2 adds accounts and contacts.
// Every business table will carry workspaceId and be covered by forced RLS.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // Trigram indexes make "contains" search fast on millions of rows (contact / account search).
  extensions = [pg_trgm]
}

enum Role {
  ceo_admin
  manager
  sales_bd
  data_researcher
}

enum MemberStatus {
  active
  suspended
}

/// A tenant. All CRM data belongs to exactly one workspace.
model Workspace {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String
  slug        String                  @unique
  createdAt   DateTime                @default(now())
  members     WorkspaceMember[]
  auditLogs   AuditLog[]
  credentials IntegrationCredential[]
  accounts    Account[]
  contacts    Contact[]
}

/// Links a Supabase Auth user (auth.users.id) to a workspace with a CRM role.
model WorkspaceMember {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  userId      String       @db.Uuid
  email       String
  fullName    String
  role        Role
  status      MemberStatus @default(active)
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Append-only record of who did what. The app role can insert and read, never update or delete.
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorId     String?   @db.Uuid
  actorEmail  String?
  action      String
  entityType  String?
  entityId    String?
  meta        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, action])
}

/// Integration secrets (API keys, tokens), AES-256-GCM encrypted. Readable only by CEO/Admin.
model IntegrationCredential {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  provider    String
  label       String    @default("default")
  ciphertext  String
  /// Last 4 characters of the secret, so the UI can show which key is saved without decrypting.
  hint        String    @default("")
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, label])
}

// ───────────────────────────── Phase 2: accounts and contacts ─────────────────────────────

/// Where a lead stands (SPEC R-3.6).
enum LeadStatus {
  new
  researching
  contacted
  engaged
  qualified
  disqualified
}

/// Can we email this person? Checked before any outreach (SPEC R-3.7, R-7.6).
enum EmailStatus {
  active
  unsubscribed
  do_not_contact
  bounced
}

enum RecordType {
  contact
  account
}

enum ActivityKind {
  note
  email
  call
  meeting
  task
  change
  system
}

enum ActivitySource {
  manual
  integration
  system
}

enum CustomFieldType {
  text
  number
  date
  select
}

/// A company. `viewerIds` is maintained by a database trigger (creator + owner + assignees); row-level security
/// uses it so Sales/BD and Researchers see only their own records, with one index lookup.
model Account {
  id              String     @id @default(uuid()) @db.Uuid
  workspaceId     String     @db.Uuid
  name            String
  domain          String?
  website         String?
  industry        String?
  sizeBand        String?
  city            String?
  region          String?
  country         String?
  phone           String?
  linkedinUrl     String?
  description     String?
  source          String?
  createdById     String     @db.Uuid
  ownerId         String?    @db.Uuid
  assigneeIds     String[]   @db.Uuid
  viewerIds       String[]   @db.Uuid
  importBatchId   String?    @db.Uuid
  verifiedAt      DateTime?
  tags            String[]
  customFields    Json       @default("{}")
  qualification   LeadStatus @default(new)
  serviceInterest String?
  nextAction      String?
  followUpAt      DateTime?
  searchText      String     @default("")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts        Contact[]

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, name, id])
  @@index([workspaceId, domain])
  @@index([workspaceId, ownerId])
  @@index([viewerIds], type: Gin)
  @@index([tags], type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// A person, optionally linked to an account.
model Contact {
  id              String      @id @default(uuid()) @db.Uuid
  workspaceId     String      @db.Uuid
  accountId       String?     @db.Uuid
  firstName       String
  lastName        String      @default("")
  fullName        String
  email           String?
  emailStatus     EmailStatus @default(active)
  phone           String?
  jobTitle        String?
  linkedinUrl     String?
  city            String?
  region          String?
  country         String?
  source          String?
  createdById     String      @db.Uuid
  ownerId         String?     @db.Uuid
  assigneeIds     String[]    @db.Uuid
  viewerIds       String[]    @db.Uuid
  importBatchId   String?     @db.Uuid
  verifiedAt      DateTime?
  tags            String[]
  customFields    Json        @default("{}")
  qualification   LeadStatus  @default(new)
  serviceInterest String?
  nextAction      String?
  followUpAt      DateTime?
  searchText      String      @default("")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, fullName, id])
  @@index([workspaceId, accountId])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, followUpAt])
  @@index([viewerIds], type: Gin)
  @@index([tags], type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// The unified timeline of a record: notes, emails, calls, meetings, tasks and field changes (SPEC R-3.5, R-5).
/// Append-only. `source` keeps manually logged activity apart from integration-confirmed activity (SPEC R-5.4).
model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  recordType  RecordType
  recordId    String         @db.Uuid
  kind        ActivityKind
  summary     String
  body        String?
  detail      Json?
  actorId     String?        @db.Uuid
  actorEmail  String?
  source      ActivitySource @default(manual)
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([workspaceId, recordType, recordId, occurredAt(sort: Desc)])
}

/// A saved filter + sort for a list (SPEC R-3.4). Private to its owner unless shared.
model SavedView {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  ownerId     String     @db.Uuid
  entity      RecordType
  name        String
  filters     Json       @default("{}")
  sort        String     @default("newest")
  shared      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, ownerId, entity, name])
  @@index([workspaceId, entity])
}

/// Admin-defined extra fields (SPEC R-3.4). Values live in the record's `customFields` JSON, keyed by `key`.
model CustomFieldDef {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  entity      RecordType
  key         String
  label       String
  type        CustomFieldType @default(text)
  options     String[]
  position    Int             @default(0)
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, entity, key])
}

/// File metadata. The file itself is in a private Supabase Storage bucket; downloads go through a short-lived signed URL
/// issued only after the record's visibility check passes.
model Attachment {
  id           String     @id @default(uuid()) @db.Uuid
  workspaceId  String     @db.Uuid
  recordType   RecordType
  recordId     String     @db.Uuid
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  uploadedById String     @db.Uuid
  createdAt    DateTime   @default(now())

  @@index([workspaceId, recordType, recordId])
}

/// One CSV upload being imported into contacts or accounts (SPEC R-8.5). Rows are staged first, then the worker applies them.
model ImportBatch {
  id            String      @id @default(uuid()) @db.Uuid
  workspaceId   String      @db.Uuid
  recordType    RecordType
  fileName      String
  uploadedById  String      @db.Uuid
  mapping       Json        @default("{}")
  duplicateMode String      @default("skip")
  status        String      @default("staging") // staging | queued | running | done | failed
  totalRows     Int         @default(0)
  accepted      Int         @default(0)
  rejected      Int         @default(0)
  duplicates    Int         @default(0)
  updated       Int         @default(0)
  createdAt     DateTime    @default(now())
  finishedAt    DateTime?
  rows          ImportRow[]

  @@index([workspaceId, createdAt(sort: Desc)])
}

/// A staged row from an import file. `raw` is what the file said; `outcome` is set by the worker.
model ImportRow {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  batchId     String      @db.Uuid
  rowNumber   Int
  raw         Json
  outcome     String      @default("pending") // pending | created | updated | duplicate | rejected | skipped
  message     String?
  recordId    String?     @db.Uuid
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, outcome, rowNumber])
  @@index([workspaceId, batchId])
}

// ───────────────────────────── Phase 4: assignments and work verification ─────────────────────────────

/// What kind of work an assignment asks for (SPEC R-4.2).
enum TaskType {
  research
  cleaning
  outreach
  calling
  follow_up
}

enum Priority {
  low
  normal
  high
  urgent
}

/// How often approved work repeats (SPEC R-4.4).
enum Recurrence {
  none
  daily
  weekly
  monthly
}

/// open (to do) → verified (submitted and passed the system checks) → approved, or rejected. Returned work goes back to open.
enum AssignmentStatus {
  open
  in_progress
  on_hold
  verified
  approved
  rejected
}

enum EvidenceKind {
  note
  link
}

/// One piece of work given to people: a task type, instructions, completion criteria and an optional target (SPEC R-4.1, R-4.3).
/// Each record in the batch gets its own `Assignment`. Visible to its creator, to anyone with an assignment in it, and to managers.
model AssignmentBatch {
  id                 String       @id @default(uuid()) @db.Uuid
  workspaceId        String       @db.Uuid
  title              String
  recordType         RecordType
  taskType           TaskType
  instructions       String?
  completionCriteria String?
  priority           Priority     @default(normal)
  requiresEvidence   Boolean      @default(true)
  dueAt              DateTime?
  recurrence         Recurrence   @default(none)
  /// How many approved assignments the batch is aiming for (shown as progress). Optional.
  targetCount        Int?
  createdById        String       @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  assignments        Assignment[]

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
}

/// One record given to one person as part of a batch. `recordType`/`recordId` point at a Contact or Account (no foreign key,
/// as with Activity). Status changes are written to `AssignmentEvent`, the history.
model Assignment {
  id               String               @id @default(uuid()) @db.Uuid
  workspaceId      String               @db.Uuid
  batchId          String               @db.Uuid
  recordType       RecordType
  recordId         String               @db.Uuid
  assigneeId       String               @db.Uuid
  assignedById     String               @db.Uuid
  title            String
  taskType         TaskType
  priority         Priority             @default(normal)
  dueAt            DateTime?
  requiresEvidence Boolean              @default(true)
  recurrence       Recurrence           @default(none)
  status           AssignmentStatus     @default(open)
  submittedAt      DateTime?
  startedAt        DateTime?
  verifiedAt       DateTime?
  holdReason       String?
  decidedAt        DateTime?
  decidedById      String?              @db.Uuid
  decisionComment  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  batch            AssignmentBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  evidence         AssignmentEvidence[]
  events           AssignmentEvent[]

  @@index([workspaceId, assigneeId, status, dueAt])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, batchId])
  @@index([workspaceId, recordType, recordId])
}

/// Proof of work attached to an assignment before it is submitted: a note or a link.
model AssignmentEvidence {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String       @db.Uuid
  assignmentId String       @db.Uuid
  kind         EvidenceKind
  body         String
  addedById    String       @db.Uuid
  createdAt    DateTime     @default(now())
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, assignmentId])
}

/// Append-only history of an assignment: assigned, reassigned (with reason), evidence, submitted, verified, approved,
/// returned, rejected, repeat started or stopped (SPEC R-4.8).
model AssignmentEvent {
  id           String            @id @default(uuid()) @db.Uuid
  workspaceId  String            @db.Uuid
  assignmentId String            @db.Uuid
  action       String
  fromStatus   AssignmentStatus?
  toStatus     AssignmentStatus?
  comment      String?
  detail       Json?
  actorId      String            @db.Uuid
  actorEmail   String?
  createdAt    DateTime          @default(now())
  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, assignmentId, createdAt])
}

/// An in-app notification for one person (the bell). Written by the person who caused it, and read only by its recipient.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  actorId     String    @db.Uuid
  kind        String
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId, readAt, createdAt(sort: Desc)])
}
