// CodeAutomation CRM schema. Phase 0 holds only the multi-tenancy root so the
// database connection can be verified end to end. Phase 1 adds roles,
// permissions and audit; Phase 2 adds accounts and contacts.
// Every business table will carry workspaceId and be covered by forced RLS.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ceo_admin
  manager
  sales_bd
  data_researcher
}

enum MemberStatus {
  active
  suspended
}

/// A tenant. All CRM data belongs to exactly one workspace.
model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  members   WorkspaceMember[]
}

/// Links a Supabase Auth user (auth.users.id) to a workspace with a CRM role.
model WorkspaceMember {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  userId      String       @db.Uuid
  email       String
  fullName    String
  role        Role
  status      MemberStatus @default(active)
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}
